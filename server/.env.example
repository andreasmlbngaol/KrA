# KrA server — local development. Copy: cp .env.example .env
# Loaded by the Spring server; never commit the real .env (see .gitignore).

# === AI ===
GOOGLE_API_KEY=

# === Auth (JWT) ===
JWT_SECRET=dev-only-change-me-to-long-random-secret
JWT_ISSUER=krs-server
JWT_AUDIENCE=krs-client
JWT_COOKIE_SECURE=false

# === PostgreSQL ===
DB_URL=jdbc:postgresql://localhost:5432/krs_db
DB_USER=postgres
DB_PASSWORD=

# === Server ===
PORT=8083
