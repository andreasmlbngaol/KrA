# KrA - PRODUCTION. Copy: cp .env.example .env
# Run: docker compose up -d --build

# === AI / API keys ===
OPENROUTER_API_KEY=

# === Auth (JWT) ===
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=krs-server
JWT_AUDIENCE=krs-client
JWT_COOKIE_SECURE=true

# === PostgreSQL ===
DB_NAME=kra_db
DB_USER=postgres
DB_PASSWORD=postgres

# === Docker host ports ===
DB_PORT_HOST=5433
WEB_PORT=80
