# KrA - DEVELOPMENT. Copy: cp .env.dev.example .env.dev
# Run: docker compose --env-file .env.dev -f docker-compose.dev.yml up

# === AI / API keys ===
OPENROUTER_API_KEY=

# === Auth (JWT) ===
JWT_SECRET=dev-only-change-me-to-long-random-secret
JWT_ISSUER=krs-server
JWT_AUDIENCE=krs-client

# === PostgreSQL ===
DB_NAME=kra_db_dev
DB_USER=postgres
DB_PASSWORD=postgres

# === Docker host ports (distinct from prod) ===
DB_PORT_HOST=5434
SERVER_PORT=8081
WEB_PORT=5173
